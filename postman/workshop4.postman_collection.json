      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado 200', () => pm.response.to.have.status(200));",
              "pm.test('Contenido esperado', () => { const b = pm.response.json(); pm.expect(b.total).to.eql(2); pm.expect(b.data).to.have.lengthOf(1); pm.expect(b.data[0]).to.have.all.keys(\"title\", \"minutes\"); pm.expect(b.data[0].minutes).to.eql(10); });"
            ]
          }
        }
      ]
    },
