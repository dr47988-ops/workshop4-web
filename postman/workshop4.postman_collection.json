    {
      "name": "Estadísticas antes",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/tasks/stats"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado 200', () => pm.response.to.have.status(200));",
              "pm.test('Contenido esperado', () => { const s = pm.response.json().data; pm.expect(s).to.have.all.keys('pending', 'done', 'byPriority'); pm.expect(s.byPriority).to.have.all.keys('low', 'medium', 'high'); pm.expect(s.pending).to.be.at.least(1); const sum = s.byPriority.low + s.byPriority.medium + s.byPriority.high; pm.expect(sum).to.eql(s.pending + s.done); pm.collectionVariables.set('pendingBefore', s.pending); pm.collectionVariables.set('doneBefore', s.done); });"
            ]
          }
        }
      ]
    },
