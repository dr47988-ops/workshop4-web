{
  "info": {
    "name": "Workshop 4 - Consultas, CRUD, métodos y estadísticas",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "Crear tarea",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/tasks",
        "body": {
          "mode": "raw",
          "raw": "{\"title\":\"Workshop Postman principal\",\"done\":false,\"priority\":\"high\",\"tags\":[\"workshop-postman\"],\"minutes\":45}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado 201', () => pm.response.to.have.status(201));",
              "pm.test('Contenido esperado', () => { const t = pm.response.json().data; pm.expect(t.title).to.eql('workshop postman principal'); pm.collectionVariables.set('taskId', t.id); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Crear segunda tarea",
      "request": {
        "method": "POST",
