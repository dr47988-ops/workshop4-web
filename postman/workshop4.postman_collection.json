{
  "info": {
    "name": "Workshop 4 - Consultas y CRUD",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "Crear tarea",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/tasks",
        "body": {
          "mode": "raw",
          "raw": "{\"title\":\"Workshop Postman principal\",\"done\":false,\"priority\":\"high\",\"tags\":[\"workshop-postman\"],\"minutes\":45}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado 201', () => pm.response.to.have.status(201));",
              "pm.test('Contenido esperado', () => { const t = pm.response.json().data; pm.expect(t.title).to.eql('Workshop Postman principal'); pm.collectionVariables.set('taskId', t.id); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Crear segunda tarea",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/tasks",
        "body": {
          "mode": "raw",
          "raw": "{\"title\":\"Workshop Postman secundaria\",\"done\":true,\"priority\":\"low\",\"tags\":[\"workshop-postman\"],\"minutes\":10}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado 201', () => pm.response.to.have.status(201));",
              "pm.test('Contenido esperado', () => { pm.collectionVariables.set('secondId', pm.response.json().data.id); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Filtros combinados",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/tasks?done=false&priority=high&search=WORKSHOP%20POSTMAN&tag=workshop-postman&minMinutes=40"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado 200', () => pm.response.to.have.status(200));",
              "pm.test('Contenido esperado', () => { const b = pm.response.json(); pm.expect(b.total).to.eql(1); pm.expect(b.data).to.have.lengthOf(1); pm.expect(b.data[0]._id).to.eql(pm.collectionVariables.get(\"taskId\")); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Orden, página y campos",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/tasks?tag=workshop-postman&sort=-minutes&limit=1&page=2&fields=title,minutes"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado 200', () => pm.response.to.have.status(200));",
              "pm.test('Contenido esperado', () => { const b = pm.response.json(); pm.expect(b.total).to.eql(2); pm.expect(b.data).to.have.lengthOf(1); pm.expect(b.data[0]).to.have.all.keys(\"title\", \"minutes\"); pm.expect(b.data[0].minutes).to.eql(10); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Página vacía conserva total",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/tasks?tag=workshop-postman&page=3&limit=1"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado 200', () => pm.response.to.have.status(200));",
              "pm.test('Contenido esperado', () => { pm.expect(pm.response.json()).to.deep.eql({data: [], total: 2}); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Buscar por ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/tasks/{{taskId}}"
