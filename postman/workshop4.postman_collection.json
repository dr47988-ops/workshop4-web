          }
        }
      ]
    },
    {
      "name": "Filtros combinados",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/tasks?done=false&priority=high&search=WORKSHOP%20POSTMAN&tag=workshop-postman&minMinutes=40"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado 200', () => pm.response.to.have.status(200));",
              "pm.test('Contenido esperado', () => { const b = pm.response.json(); pm.expect(b.total).to.eql(1); pm.expect(b.data).to.have.lengthOf(1); pm.expect(b.data[0]._id).to.eql(pm.collectionVariables.get(\"taskId\")); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Orden, página y campos",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/tasks?tag=workshop-postman&sort=-minutes&limit=1&page=2&fields=title,minutes"
