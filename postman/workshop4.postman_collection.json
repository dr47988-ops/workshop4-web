      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado 200', () => pm.response.to.have.status(200));",
              "pm.test('Contenido esperado', () => { pm.expect(pm.response.json().data.done).to.eql(true); pm.expect(pm.response.json().data.minutes).to.eql(60); });"
            ]
          }
        }
      ]
    },
